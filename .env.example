# Copy to .env and fill in only what you need.
#
# Every provider defaults to "mock", so the application runs and the full test
# suite passes with this file absent and no credentials at all. Switch a mode to
# "live" only when you want that stage to call a real service.

# --- Speech to text -------------------------------------------------------
PERSONAE_STT_MODE=mock            # mock | live
PERSONAE_DEEPGRAM_API_KEY=
PERSONAE_STT_MODEL=nova-3         # nova-3 | nova-2 | flux-general-en

# --- Text to speech -------------------------------------------------------
PERSONAE_TTS_MODE=mock            # mock | live
# Reuses PERSONAE_DEEPGRAM_API_KEY.
# Fallback voice. A character pack that names its own voice takes precedence.
# Female: thalia, luna, athena, aurora, pandora (British), cordelia
# Male:   apollo, orion, zeus, jupiter, atlas
PERSONAE_TTS_VOICE=aura-2-thalia-en

# --- Turn taking ----------------------------------------------------------
# Silence, in milliseconds, before she treats a turn as finished. Lower feels
# quicker to answer but cuts people off mid-thought; raise it if she interrupts.
PERSONAE_ENDPOINTING_MS=800
PERSONAE_UTTERANCE_END_MS=1000

# --- Language model -------------------------------------------------------
PERSONAE_LLM_MODE=mock            # mock | live
PERSONAE_LLM_BASE_URL=https://api.openai.com/v1
PERSONAE_LLM_API_KEY=
PERSONAE_LLM_MODEL=gpt-4o-mini
