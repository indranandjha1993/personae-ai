# Configuration reference; put actual values in .env. Empty provider keys use demos.
# After edits: docker compose up -d --force-recreate backend; refresh the browser.

# --- FastAPI server ---
# Host/port apply to python -m personae; Compose uses 0.0.0.0:8000 internally.
PERSONAE_SERVER_HOST=127.0.0.1
PERSONAE_SERVER_PORT=8000
PERSONAE_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
PERSONAE_PORT=47465                     # Published webpage port (Compose)

# --- Character and appearance ---
# IDs: bundled/seed (Wren), bundled/mentor (Sage), bundled/analyst (Atlas).
# CHARACTER_ID selects personality. APPEARANCE_ID selects a pack's avatar only.
# Blank appearance uses the character's avatar. All bundled packs share one model.
# Custom appearance: add a pack with a different avatar and use its <pack>/<character> ID.
PERSONAE_CHARACTER_ID=bundled/seed
PERSONAE_APPEARANCE_ID=
PERSONAE_PACK_SEARCH_PATHS=["packs/bundled","packs/local"]
PERSONAE_RENDER_QUALITY=auto            # auto | high | low

# --- Conversation ---
# STT and TTS are independent. The selected TTS provider's *_TTS_VOICE is authoritative.
PERSONAE_STT_PROVIDER=deepgram          # deepgram | elevenlabs | mock
PERSONAE_TTS_PROVIDER=deepgram          # deepgram | elevenlabs | local | mock
PERSONAE_ALLOW_VOICE_INTERRUPTION=true
PERSONAE_MICROPHONE_AUTO_VOLUME=false   # Automatic gain; may amplify room noise

# --- Lip sync ---
# Rhubarb requires an installed executable and buffers each phrase for alignment.
PERSONAE_LIP_SYNC=audio                 # audio | rhubarb
PERSONAE_RHUBARB_PATH=rhubarb
PERSONAE_RHUBARB_RECOGNIZER=phonetic     # phonetic | pocketSphinx

# --- Access credentials ---
# App-owned conversation password, not a provider key. Blank disables authentication.
# If set, open the webpage with ?token=<same-secret>; only WebSocket access is protected.
PERSONAE_ACCESS_TOKEN=

# --- Language model ---
# Keep endpoint, key, model and API format aligned. OpenRouter uses wire=openai
# and base URL https://openrouter.ai/api/v1. Model IDs depend on your endpoint.
PERSONAE_LLM_API_KEY=
PERSONAE_LLM_BASE_URL=https://api.openai.com/v1
PERSONAE_LLM_MODEL=gpt-4o-mini
PERSONAE_LLM_WIRE=openai                # openai | anthropic
PERSONAE_LLM_VISION=false               # Enable for vision-capable OpenAI-compatible models
# Optional separate vision model for the Anthropic-compatible adapter.
PERSONAE_VISION_MODEL=

# --- Deepgram ---
# Shared STT/TTS key. Flux STT is English-only here; Nova uses STT_LANGUAGE.
# TTS_VOICE selects the voice and adapter: flux-* or aura-*.
PERSONAE_DEEPGRAM_API_KEY=
PERSONAE_DEEPGRAM_STT_MODEL=flux-general-en
PERSONAE_DEEPGRAM_STT_LANGUAGE=en
PERSONAE_DEEPGRAM_TTS_VOICE=flux-haley-en
# Nova timing (ms); shorter silence responds sooner but may split pauses.
PERSONAE_DEEPGRAM_STT_ENDPOINTING_MS=300
PERSONAE_DEEPGRAM_STT_UTTERANCE_END_MS=1000
# Flux confidence (0.5–1.0) and silence fallback (500–60000 ms).
PERSONAE_DEEPGRAM_STT_EOT_THRESHOLD=0.7
PERSONAE_DEEPGRAM_STT_EOT_TIMEOUT_MS=2000
# Optional speculation (0.3–0.9, <= EOT_THRESHOLD); blank disables it.
PERSONAE_DEEPGRAM_STT_EAGER_EOT_THRESHOLD=

# --- ElevenLabs ---
# Shared STT/TTS key. STT language blank = auto-detect.
# TTS_VOICE is the ElevenLabs voice ID, not a display name; required for live TTS.
PERSONAE_ELEVENLABS_API_KEY=
PERSONAE_ELEVENLABS_STT_MODEL=scribe_v2_realtime
PERSONAE_ELEVENLABS_STT_LANGUAGE=
PERSONAE_ELEVENLABS_STT_SILENCE_SECONDS=0.6          # 0.3–3.0 seconds before a turn completes
PERSONAE_ELEVENLABS_STT_FILTER_BACKGROUND_AUDIO=true # Requests filtering, not speaker isolation
# TTS: eleven_v3 waits for the full reply for continuous prosody; flash starts per sentence.
PERSONAE_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
PERSONAE_ELEVENLABS_TTS_VOICE=

# --- Local TTS ---
# Requires a compatible PCM16/24kHz server. Blank URL uses demo speech.
# Example: http://localhost:8880/v1 (Docker: http://host.docker.internal:8880/v1).
# API key is optional; model and voice must be installed on that server.
PERSONAE_LOCAL_TTS_API_KEY=
PERSONAE_LOCAL_TTS_BASE_URL=
PERSONAE_LOCAL_TTS_MODEL=kokoro
PERSONAE_LOCAL_TTS_VOICE=af_heart
