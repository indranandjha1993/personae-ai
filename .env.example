# Copy to .env. Empty API keys use demo providers.
# Apply edits: docker compose up -d --force-recreate backend; refresh browser.

# Character: bundled/seed (Wren), bundled/mentor (Sage), bundled/analyst (Atlas).
PERSONAE_CHARACTER_ID=bundled/seed
# Blank = character's avatar
PERSONAE_APPEARANCE_ID=
PERSONAE_RENDER_QUALITY=auto        # auto | high | low

# DEEPGRAM_API_KEY is shared by Deepgram listening and speaking.
# Listening (STT): always Deepgram; independent of the speaking provider.
PERSONAE_DEEPGRAM_API_KEY=
PERSONAE_DEEPGRAM_STT_MODEL=flux-general-en
PERSONAE_DEEPGRAM_STT_LANGUAGE=en

# Speaking (TTS): choose provider AND voice selection below.
PERSONAE_TTS_PROVIDER=deepgram       # deepgram | elevenlabs | local | mock
PERSONAE_VOICE_ID=default
# default uses TTS_PROVIDER and allows character-pack voice overrides.
# To control voice strictly from .env, use the matching selection:
#   Deepgram:   TTS_PROVIDER=deepgram   VOICE_ID=deepgram:default
#   ElevenLabs: TTS_PROVIDER=elevenlabs VOICE_ID=elevenlabs:default
#   Local:      TTS_PROVIDER=local      VOICE_ID=local:af_heart
# A provider-specific VOICE_ID overrides TTS_PROVIDER; change BOTH when switching.

PERSONAE_DEEPGRAM_TTS_VOICE=flux-haley-en     # Deepgram voice/model ID only
PERSONAE_ELEVENLABS_TTS_API_KEY=
PERSONAE_ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Voice ID from ElevenLabs, not its display name
PERSONAE_ELEVENLABS_TTS_VOICE=

# Local speech is optional; requires a running PCM16/24kHz-compatible server.
# In Docker, use http://host.docker.internal:8880/v1 to reach a host server.
# PERSONAE_LOCAL_TTS_BASE_URL=http://localhost:8880/v1
# PERSONAE_LOCAL_TTS_MODEL=kokoro
# PERSONAE_LOCAL_TTS_VOICE=af_heart
# PERSONAE_LOCAL_TTS_VOICES=["af_heart","af_bella"]

# Brain (LLM): unrelated to STT/TTS models. Keep URL, key, model and wire aligned.
PERSONAE_LLM_BASE_URL=https://api.openai.com/v1
PERSONAE_LLM_API_KEY=
PERSONAE_LLM_MODEL=gpt-4o-mini
PERSONAE_LLM_WIRE=openai            # openai | anthropic (API format, not model brand)
# OpenRouter: BASE_URL=https://openrouter.ai/api/v1, WIRE=openai,
# MODEL=<provider/model ID available in your account>, API_KEY=<OpenRouter key>.
PERSONAE_LLM_VISION=false           # Enable only for a vision-capable model
# Separate vision model for anthropic wire only
PERSONAE_VISION_MODEL=

# Optional tuning; defaults shown. See docs/rendering.md for speech timing.
PERSONAE_LIP_SYNC=audio             # audio | rhubarb (requires local executable)
PERSONAE_DEEPGRAM_STT_EOT_THRESHOLD=0.7
PERSONAE_DEEPGRAM_STT_EOT_TIMEOUT_MS=2000
# Blank disables speculative replies
PERSONAE_DEEPGRAM_STT_EAGER_EOT_THRESHOLD=
# If set, WebSocket clients must supply ?token=...
PERSONAE_ACCESS_TOKEN=

# Let your voice interrupt the avatar while it speaks.
PERSONAE_ALLOW_VOICE_INTERRUPTION=true
# Automatically adjust microphone volume (may also raise background noise).
PERSONAE_MICROPHONE_AUTO_VOLUME=false
