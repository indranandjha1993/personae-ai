# Copy to .env and fill in only what you need.
#
# Every provider defaults to "mock", so the application runs and the full test
# suite passes with this file absent and no credentials at all. Switch a mode to
# "live" only when you want that stage to call a real service.

# --- Speech to text -------------------------------------------------------
PERSONAE_STT_MODE=mock            # mock | live
PERSONAE_DEEPGRAM_API_KEY=

# --- Language model -------------------------------------------------------
PERSONAE_LLM_MODE=mock            # mock | live
PERSONAE_LLM_BASE_URL=https://api.openai.com/v1
PERSONAE_LLM_API_KEY=
PERSONAE_LLM_MODEL=gpt-4o-mini

# --- Text to speech -------------------------------------------------------
PERSONAE_TTS_MODE=mock            # mock | live
# Reuses PERSONAE_DEEPGRAM_API_KEY.
