# Copy to .env and fill in what you have. Nothing here is required: with no
# keys the project still runs and the whole test suite passes on stand-ins, so
# a fresh clone works immediately.

# --- Speech (Deepgram) ----------------------------------------------------
# Set this and both transcription and speech go live.
PERSONAE_DEEPGRAM_API_KEY=
PERSONAE_STT_MODEL=flux-general-en   # flux-general-en | nova-3 | nova-2

# Flux is Deepgram's voice-agent line: it decides when a turn has ended itself,
# which is quicker and steadier than tuning silences by hand. It speaks English
# only. For any other language use nova for transcription and an aura-2 voice
# for speech; the app refuses a pairing that would fail at the socket.
#
# Deepgram transcribes over a hundred and forty languages, but not all of them
# on every model. German, Japanese and Dutch work on nova-3; Spanish, French,
# Portuguese, Hindi, Russian, Chinese, Korean and others need nova-2. Speech
# synthesis covers seven: English, Spanish, French, German, Italian, Dutch and
# Japanese -- pick a voice in the same language, or she answers in the wrong
# accent.
#   Spanish   STT_LANGUAGE=es  STT_MODEL=nova-2  TTS_VOICE=aura-2-celeste-es
#   French    STT_LANGUAGE=fr  STT_MODEL=nova-2  TTS_VOICE=aura-2-agathe-fr
#   German    STT_LANGUAGE=de  STT_MODEL=nova-3  TTS_VOICE=aura-2-elara-de
#   Japanese  STT_LANGUAGE=ja  STT_MODEL=nova-3  TTS_VOICE=aura-2-uzume-ja
PERSONAE_STT_LANGUAGE=en
# Fallback voice; a character pack naming its own voice takes precedence.
# Flux (English):  haley, alexis, sienna, heather, hannah, brooke, gemma (British)
# Aura-2 female:   thalia, andromeda, helena, harmonia, vesta, luna, athena
# Aura-2 male:     apollo, orion, zeus, jupiter, atlas
PERSONAE_TTS_VOICE=flux-haley-en

# --- Turn taking ----------------------------------------------------------
# How sure Flux must be that a turn has ended before she answers. Higher waits
# longer but clips fewer words off the end of a sentence. 0.85 is Deepgram's
# high-reliability setting; lower values answer sooner but split a sentence
# at a pause for thought.
PERSONAE_EOT_THRESHOLD=0.85
# How long a silence may run before the turn is closed regardless. This is
# how long you may pause mid-thought -- to hum, to find a word -- before she
# takes the turn anyway.
PERSONAE_EOT_TIMEOUT_MS=8000
# How sure Flux must be that a turn has *probably* ended, a beat before it is
# certain. She starts drafting her answer from that moment and throws it away
# if you carry on. Only for a hosted model that stops generating when the
# request is dropped: a local server keeps going, and the real reply waits
# behind the abandoned draft. Leave empty to keep it off.
PERSONAE_EAGER_EOT_THRESHOLD=

# Used by the nova models instead, which detect the end of a turn from silence
# rather than from the words themselves.
PERSONAE_ENDPOINTING_MS=300
PERSONAE_UTTERANCE_END_MS=1000

# --- Language model -------------------------------------------------------
# Set the key and the endpoint and the model goes live.
PERSONAE_LLM_API_KEY=
PERSONAE_LLM_BASE_URL=https://api.openai.com/v1
PERSONAE_LLM_MODEL=gpt-4o-mini

# How the endpoint expects requests. This is the setting that decides whether
# the camera works, because the two formats disagree on how images are sent.
#   openai    -- OpenAI, OpenRouter, Groq, Gemini's compatible endpoint, most
#                local servers. Text only.
#   anthropic -- the Claude API and gateways that speak it, and LM Studio's
#                /v1/messages. Required for vision.
PERSONAE_LLM_WIRE=openai

# Examples
#   OpenAI      BASE_URL=https://api.openai.com/v1        MODEL=gpt-4o-mini
#   OpenRouter  BASE_URL=https://openrouter.ai/api/v1     MODEL=anthropic/claude-sonnet-4
#   Gemini      BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#               MODEL=gemini-2.0-flash
#   Anthropic   BASE_URL=https://api.anthropic.com/v1     WIRE=anthropic
#
# A model running on your own machine (LM Studio, Ollama, llama.cpp) works too.
# Any key will do -- local servers rarely check it, but the app treats an empty
# key as "no model configured".
#   LM Studio   BASE_URL=http://localhost:1234/v1         MODEL=<the loaded model>
#               (add WIRE=anthropic and a vision-capable model for the camera)
#   Ollama      BASE_URL=http://localhost:11434/v1        MODEL=llama3.2
#
# Running under Docker, localhost is the container rather than your machine, so
# reach the host by name instead:
#   LM Studio   BASE_URL=http://host.docker.internal:1234/v1
# LM Studio also needs "Serve on Local Network" enabled, or it binds to
# loopback only and the container cannot see it.

# --- Access --------------------------------------------------------------
# The websocket spends metered speech and language credits. Unset it stays
# open, which is fine on localhost; set a token for anything reachable from
# elsewhere, and the client must then connect with ?token=...
PERSONAE_ACCESS_TOKEN=

# Vision often warrants a larger model than conversation. Defaults to
# PERSONAE_LLM_MODEL when unset.
PERSONAE_VISION_MODEL=
